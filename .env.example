# StocksV2 Environment Variables
# Copy this file to .streamlit/secrets.toml and fill in your API keys

# ============================================
# REDDIT API (Highly Recommended)
# ============================================
# Get free API keys at: https://www.reddit.com/prefs/apps
# 1. Click "Create App" or "Create Another App"
# 2. Select "script" type
# 3. Name: StocksV2App
# 4. Redirect URI: http://localhost:8501
# 5. Copy client_id (under app name) and secret

REDDIT_CLIENT_ID = "your_reddit_client_id_here"
REDDIT_CLIENT_SECRET = "your_reddit_client_secret_here"
REDDIT_USER_AGENT = "StocksV2App/1.0"

# ============================================
# NEWS API (Optional)
# ============================================
# Get free API key at: https://newsapi.org/register
# Free tier: 100 requests per day

NEWS_API_KEY = "your_newsapi_key_here"

# ============================================
# NOTES
# ============================================
# - Reddit API provides sentiment from wallstreetbets, r/stocks, r/investing
# - NewsAPI provides financial news sentiment (optional but recommended)
# - App works without API keys but shows simulated sentiment data
# - With API keys: Real-time sentiment from 7+ Reddit sources + news
